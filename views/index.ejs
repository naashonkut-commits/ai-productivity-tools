<%- include('layout', { body: `
<!-- ── Hero ───────────────────────────────────────── -->
<section class="hero">
  <div class="hero-bg"></div>
  <div class="container hero-inner">
    <div class="hero-badge">Now with 10 AI-powered commands</div>
    <h1>Supercharge Your <span class="gradient-text">VS Code</span> Workflow</h1>
    <p class="hero-sub">
      10 AI-powered tools — explain code, generate commits, review code, find dead imports, 
      blame lines, summarize files, refactor symbols, and more. All inside your editor.
    </p>
    <div class="hero-actions">
      <a href="/download" class="btn btn-primary btn-lg">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
        Install Extension
      </a>
      <a href="/ai-chat" class="btn btn-secondary btn-lg">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
        Try AI Chat
      </a>
    </div>
    <div class="hero-shortcuts">
      <span class="shortcut-label">Quick start:</span>
      <kbd>Ctrl+Shift+E</kbd> Explain Code
      <kbd>Ctrl+Shift+G</kbd> Commit
      <kbd>Ctrl+Shift+W</kbd> Bwat Web
    </div>
  </div>
</section>

<!-- ── Features Grid ──────────────────────────────── -->
<section class="features-section" id="features">
  <div class="container">
    <h2 class="section-title">All <span class="accent">10 Commands</span></h2>
    <p class="section-sub">Everything you need to code faster, cleaner, and smarter.</p>
    <div class="features-grid">
      <% (locals.features || []).forEach(function(f) { %>
      <div class="feature-card">
        <div class="feature-icon"><%= f.icon %></div>
        <h3><%= f.title %></h3>
        <p><%= f.desc %></p>
      </div>
      <% }) %>
    </div>
  </div>
</section>

<!-- ── Shortcuts Table ────────────────────────────── -->
<section class="shortcuts-section">
  <div class="container">
    <h2 class="section-title">Keyboard <span class="accent">Shortcuts</span></h2>
    <p class="section-sub">All commands accessible from the keyboard. Linux / Windows / Mac.</p>
    <div class="shortcuts-table-wrap">
      <table class="shortcuts-table">
        <thead>
          <tr><th>Shortcut</th><th>Command</th></tr>
        </thead>
        <tbody>
          <% (locals.shortcuts || []).forEach(function(s) { %>
          <tr>
            <td><kbd><%= s.keys.replace(' / ', '</kbd> / <kbd>') %></kbd></td>
            <td><%= s.cmd %></td>
          </tr>
          <% }) %>
        </tbody>
      </table>
    </div>
  </div>
</section>

<!-- ── Stats ───────────────────────────────────────── -->
<section class="stats-section">
  <div class="container stats-grid">
    <div class="stat"><span class="stat-num">10</span><span class="stat-label">Commands</span></div>
    <div class="stat"><span class="stat-num">9</span><span class="stat-label">Shortcuts</span></div>
    <div class="stat"><span class="stat-num">6</span><span class="stat-label">Languages</span></div>
    <div class="stat"><span class="stat-num">100%</span><span class="stat-label">Free</span></div>
  </div>
</section>

<!-- ── CTA ─────────────────────────────────────────── -->
<section class="cta-section">
  <div class="container cta-inner">
    <h2>Ready to try it?</h2>
    <p>Install from the VS Code Marketplace or download the .vsix directly.</p>
    <div class="cta-actions">
      <a href="/download" class="btn btn-primary btn-lg">Download Extension</a>
      <a href="https://github.com/naashonkut-commits/ai-productivity-tools" target="_blank" rel="noopener" class="btn btn-outline btn-lg">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0c-6.626 0-12 5.373-12 12 0 5.302 3.438 9.8 8.207 11.387.599.111.793-.261.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.745.083-.729.083-.729 1.205.084 1.839 1.237 1.839 1.237 1.07 1.834 2.807 1.304 3.492.997.107-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.931 0-1.311.469-2.381 1.236-3.221-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23.957-.266 1.983-.399 3.003-.404 1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.911 1.235 3.221 0 4.609-2.807 5.624-5.479 5.921.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576 4.765-1.589 8.199-6.086 8.199-11.386 0-6.627-5.373-12-12-12z"/></svg>
        View on GitHub
      </a>
    </div>
  </div>
</section>
` }) %>
